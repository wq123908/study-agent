# 模型配置（DeepSeek 或任意兼容 OpenAI 协议的服务）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FALLBACK_MODEL=

# 引擎与上下文参数（可选，均有合理默认值）
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
AGENT_MAX_STEPS=8
CONTEXT_MAX_TOKENS=6000
SUMMARY_TRIGGER_TOKENS=1500
AGENT_DATA_DIR=data

# Web 服务鉴权（可选，多个 Key 用英文逗号分隔；留空表示本地开发不鉴权）
APP_API_KEYS=
